<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Photography_Tools.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:themeservice="clr-namespace:Photography_Tools.Services.ThemeService"
    x:Name="SettingsPage0"
    x:Class="Photography_Tools.Pages.SettingsPage"
    x:DataType="viewmodels:SettingsViewModel"
    Title="SettingsPage">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SettingsPage0}, x:DataType=ContentPage}"
            Command="{Binding AppearingCommand}"
        />
        <toolkit:EventToCommandBehavior
            EventName="Disappearing"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SettingsPage0}, x:DataType=ContentPage}"
            Command="{Binding DisappearingCommand}"
        />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout
            Style="{StaticResource PageVerticalStackLayout}">
            
            <Border
                Style="{StaticResource StandardBorder}">
                <VerticalStackLayout>
                    <Label
                        Text="Data source"
                        Style="{StaticResource LabelMediumBold}" 
                    />

                    <Grid
                        ColumnDefinitions="auto,*"
                        Margin="0,10,0,0">
                        
                        <CheckBox 
                            IsChecked="{Binding IsUseOfflineDataSourceModeEnabled}" 
                        />

                        <Label
                            Grid.Column="1"
                            Text="Use only offline data (lower accuracy)"
                            Style="{StaticResource LabelMedium}"
                            LineBreakMode="WordWrap"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleOfflineDataOnlyCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding IsVibrationsSupported}"
                Style="{StaticResource StandardBorder}"
                Margin="0,15,0,0">

                <VerticalStackLayout>
                    <Label
                        Text="Notifications"
                        Style="{StaticResource LabelMediumBold}" 
                    />

                    <HorizontalStackLayout
                        IsVisible="{Binding IsVibrationsSupported}"
                        Margin="0,10,0,0">

                        <CheckBox 
                            IsChecked="{Binding IsVibrationsEnabled}" 
                        />

                        <Label
                            Text="Vibrations"
                            Style="{StaticResource LabelMedium}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleVibrationsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border
                Style="{StaticResource StandardBorder}"
                Margin="0,15,0,0">
                <VerticalStackLayout
                    RadioButtonGroup.GroupName="theme"
                    RadioButtonGroup.SelectedValue="{Binding ThemeSelected}">
                    <Label
                        Text="Theme"
                        Style="{StaticResource LabelMediumBold}" 
                    />

                    <RadioButton
                        Content="System"
                        Value="{Static themeservice:IThemeService.System}"
                        FontSize="Medium">
                        <RadioButton.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeThemeCommand}" CommandParameter="{Static themeservice:IThemeService.System}"/>
                        </RadioButton.GestureRecognizers>
                    </RadioButton>

                    <RadioButton
                        Content="Light"
                        Value="{Static themeservice:IThemeService.Light}"
                        FontSize="Medium">
                        <RadioButton.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeThemeCommand}" CommandParameter="{Static themeservice:IThemeService.Light}"/>
                        </RadioButton.GestureRecognizers>
                    </RadioButton>

                    <RadioButton
                        Content="Dark"
                        Value="{Static themeservice:IThemeService.Dark}"
                        FontSize="Medium">
                        <RadioButton.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeThemeCommand}" CommandParameter="{Static themeservice:IThemeService.Dark}"/>
                        </RadioButton.GestureRecognizers>
                    </RadioButton>
                </VerticalStackLayout>
            </Border>

            <Border
                Style="{StaticResource StandardBorder}"
                Margin="0,15,0,0">
                <VerticalStackLayout>
                    <Label
                        Text="Preferences"
                        Style="{StaticResource LabelMediumBold}" 
                    />

                    <Button
                        Text="Clear all"
                        Margin="0,15,0,0"
                        HorizontalOptions="Start"
                        Command="{Binding ResetAllPreferencesCommand}"
                    />
                </VerticalStackLayout>
            </Border>

            <Border
                Style="{StaticResource StandardBorder}"
                Margin="0,15,0,0">
                <VerticalStackLayout>
                    <Label
                        Text="Licens"
                        Style="{StaticResource LabelMediumBold}" 
                    />

                    <Button
                        Text="License"
                        Margin="0,15,0,0"
                        HorizontalOptions="Start"
                        Command="{Binding ShowLicenseCommand}"
                    />
                    
                    <Button
                        Text="Third-Party Notices"
                        Margin="0,15,0,0"
                        HorizontalOptions="Start"
                        Command="{Binding ShowThirdPartyNoticesCommand}"
                    />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>